# ─────────────────────────────────────────────────────────────────────────────
# AxionLimit Backend Environment Variables Configuration Template
# Copy this file to .env on your deployment host and customize values.
# NEVER commit the production .env file to version control!
# ─────────────────────────────────────────────────────────────────────────────

# Server Environment & Port
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas cluster: Connect -> Connect your application -> Driver Node.js
# Ensure your EC2 public IP is allowlisted in MongoDB Atlas Network Access.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/axionlimit?retryWrites=true&w=majority

# Redis Connection URL
# For Docker Compose deployments, use internal Docker DNS: redis://redis:6379
# (Redis is strictly private on the internal Docker bridge network; never expose port 6379).
REDIS_URL=redis://redis:6379

# JWT Authentication Secret
# REQUIRED in production mode. Must be a high-entropy cryptographically random string (min 64 chars).
# Generate using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Frontend Public Base URL
# The public HTTP/HTTPS URL where users access the application (e.g. http://<ec2-public-ip> or https://yourdomain.com).
# Used for CORS validation and OAuth redirection.
FRONTEND_URL=http://<ec2-public-ip>

# Google OAuth 2.0 Credentials (Optional)
# If Google login is enabled in production, provide credentials from Google Cloud Console.
# Note: Google OAuth requires a valid publicly accessible domain or IP and matching Authorized Redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://<ec2-public-ip>/auth/google/callback

# Developer Mock Login Toggle
# MUST remain false in production mode. Setting to true allows instant unauthenticated developer login.
ENABLE_DEV_LOGIN=false

# EC2 Node / Server Name (Identifier for telemetry and health check endpoint)
EC2_SERVER_NAME=EC2-Mumbai
